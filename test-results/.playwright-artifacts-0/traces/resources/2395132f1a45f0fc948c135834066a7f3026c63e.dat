{"query":"query GetSubCategoriesByCategory($categoryIds: [String!]!) {\n  subCategoryFieldses(\n    where: {\n      categories: { some: { id: { in: $categoryIds } } }\n      published: { equals: true }\n    }\n    orderBy: [{\n       order: {\n        sort: asc\n       }\n    }]\n  ) {\n    id\n    name\n    order\n    subCategory {\n      id\n    }\n  }\n}\n","variables":{"categoryIds":["cl38x9cmz1i9v0a22965q29br","cl38x8w0e2bjh0b89iwfrj3c4","cl38x90o91i8u0a224huxffgv","cl38x8qb21hxb0b35v412fsgy","cl38x962j1icg0a161hc2kzz1","cl38x83851hp40b13wu8ko23o","cl38x8kry1i760a22rxkr9qit","cl38x8ef41i6c0a22yso25z21","cl38x89fi1hq10b13cl4am4xb"]}}