{"query":"query GetAllJurisdictions {\n  locationFieldses(\n    where: { hiddenFromFilters: { equals: false } }\n    orderBy: [{\n       order: {\n        sort: asc\n       }\n    }]\n  ) {\n    id\n    isoCountryCode\n    name\n    publishedDate\n    order\n    isEEA\n    location {\n      id\n    }\n  }\n}\n","variables":{}}